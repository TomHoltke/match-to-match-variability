# ---- Private data: NEVER in git ----
# Raw tracking data, saved games, identified feature tables and the
# pseudonymisation keys all live in data/private/ on the data owner's machine.
/data/private/

# Safety net: identifying or raw files anywhere else
*_identified*
*crosswalk*
*.dat
*.parquet

# Machine-specific paths
config/paths.toml

# ---- Python ----
.venv/
.venv.nosync/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/

# ---- Office lock files ----
~$*
